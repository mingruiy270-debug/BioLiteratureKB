# BioLiteratureKB 环境变量示例 —— 复制为 .env 并填写真实值
# 不得把真实密钥提交到 git

# OpenAI-compatible API（可用 DeepSeek / OpenAI / 本地 vLLM 等）
BIOKB_LLM_API_KEY=sk-xxxx
BIOKB_LLM_BASE_URL=https://api.deepseek.com
BIOKB_LLM_MODEL=deepseek-v4-flash

# 可选：thinking 模式与推理深度（默认 enabled / high）
# BIOKB_LLM_THINKING=enabled
# BIOKB_LLM_REASONING_EFFORT=high

# 知识库根目录（可选；默认自动定位到 config.yaml 所在目录）
# BIOKB_ROOT=E:\学习\硕士\小论文投稿\hjx论文生信\第一部分_公共数据分析工作区\最新生信文章知识库
